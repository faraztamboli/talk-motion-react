# YouTube search in the Subtitle Designer
VITE_YOUTUBE_API_KEY=

# Legacy RemotePy socket
VITE_WS_SERVER_URL=wss://app.talk-motion.com:8083

# TalkMotion 2.0 API (server/api). Leave empty in dev: `npm run dev` proxies /api and /ws.
VITE_API_BASE_URL=
VITE_API_WS_URL=
# Dev proxy target for /api and /ws
VITE_API_PROXY_TARGET=http://localhost:8000

# Feature flag build defaults; a signed-in user's flags from the API override these.
# v1 models/store/trainer stay visible unless this is "false".
VITE_FLAG_LEGACY_MODELS_VISIBLE=true
VITE_FLAG_CONVERSATION_V2=false
# Allow local flag overrides (Settings page) in a production build
VITE_FLAG_OVERRIDES=false
